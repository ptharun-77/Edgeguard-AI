# Copy to backend/.env and fill in. Never commit the real file.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://edgeguard:CHANGE_ME@localhost:5432/edgeguard
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
# Optional: creates the first ADMIN only if the users table is empty
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Used by docker-compose.yml (put in a root-level .env)
POSTGRES_PASSWORD=CHANGE_ME
